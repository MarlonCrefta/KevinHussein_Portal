# =====================================================
# KEVIN HUSSEIN TATTOO STUDIO - DOCKER COMPOSE ENV
# =====================================================
#
# COMO USAR:
#   1. Copie este arquivo: cp .env.example .env
#   2. Edite o .env com seus valores reais
#   3. Rode: docker-compose up -d --build
#
# GERAR SECRETS SEGUROS:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#

# ─── Frontend (Vite) ─────────────────────────────
VITE_API_URL=/api

# ─── Backend: CORS ───────────────────────────────
# URL do frontend para permitir requisições cross-origin
# Em produção: https://seudominio.com
FRONTEND_URL=http://localhost

# ─── Backend: JWT (OBRIGATÓRIO) ──────────────────
# Gere valores únicos com o comando acima
JWT_SECRET=GERE_UM_TOKEN_SEGURO_AQUI
JWT_REFRESH_SECRET=GERE_OUTRO_TOKEN_SEGURO_AQUI
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Backend: Admin (OBRIGATÓRIO) ────────────────
# Usuário criado no primeiro run. Senha MÍNIMO 8 caracteres.
ADMIN_USERNAME=kevin
ADMIN_PASSWORD=SUA_SENHA_FORTE_AQUI_8CHARS
ADMIN_NAME=Kevin Hussein
