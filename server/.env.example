# =====================================================
# KEVIN HUSSEIN TATTOO STUDIO - CONFIGURAÇÃO DO SERVIDOR
# =====================================================
# 
# COMO USAR:
#   1. Copie este arquivo: cp server/.env.example server/.env
#   2. Edite o .env com seus valores reais
#   3. Em PRODUÇÃO, JWT_SECRET, JWT_REFRESH_SECRET, ADMIN_PASSWORD
#      e FRONTEND_URL são OBRIGATÓRIOS (servidor não inicia sem eles)
#
# GERAR SECRETS SEGUROS:
#   openssl rand -base64 32
#

# ─── Variáveis principais ──────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=https://seu-dominio.com
JWT_SECRET=gere-um-secret-forte-aqui
JWT_REFRESH_SECRET=gere-outro-secret-forte-aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_USERNAME=kevin
ADMIN_PASSWORD=senha-forte-minimo-8-chars
ADMIN_NAME=Kevin Hussein
DATABASE_PATH=/app/data/database.sqlite
SCHEDULER_ENABLED=true
WHATSAPP_SESSION_PATH=/app/auth_info_baileys
WHATSAPP_AUTO_CONNECT=true

# ─── Variáveis opcionais documentadas ──────────
# LOG_LEVEL=warn
# LOG_FILE=./logs/app.log
# BACKUP_DIR=/app/backups
# MAX_BACKUPS=30
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# BUSINESS_HOURS_START=9
# BUSINESS_HOURS_END=20
